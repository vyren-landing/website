# Connect an isolated Neon Postgres store to vyren-command-center in Vercel.
DATABASE_URL=
# Github OAuth App created under github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 32+ byte secret generated and stored in Vercel (do not commit or paste).
BETTER_AUTH_SECRET=
# GitHub numeric user ID for the existing founder account (not a secret).
FOUNDER_GITHUB_ACCOUNT_ID=249065858
# Optional, only after explicit approval of a separate real test GitHub identity.
TEST_GITHUB_ACCOUNT_ID=
# Optional Google OAuth for a single authorized Preview contributor.
# Register callback https://<stable-preview-alias>/api/auth/callback/google.
# If these credentials are missing, the Google button/provider stay disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Approved Google-verified test email; keep this in Vercel Preview env, not GitHub.
TEST_GOOGLE_EMAIL=
# Optionally pin the stable Google "sub" from the provider account record after first login.
TEST_GOOGLE_ACCOUNT_ID=
# On preview set BETTER_AUTH_URL to the stable branch alias, not a one-off URL.
BETTER_AUTH_URL=
# Stay disabled until DB and auth are verified end to end.
CC_LIVE_ENABLED=false
# Leave BETTER_AUTH_URL unset in Preview; set fixed app origin only in production.
