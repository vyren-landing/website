# Connect an isolated Neon Postgres store to vyren-command-center in Vercel.
DATABASE_URL=
# Github OAuth App created under github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 32+ byte secret generated and stored in Vercel (do not commit or paste).
BETTER_AUTH_SECRET=
# GitHub numeric user ID for the existing founder account (not a secret).
FOUNDER_GITHUB_ACCOUNT_ID=249065858
# Optional, only after explicit approval of a separate real test GitHub identity.
TEST_GITHUB_ACCOUNT_ID=
# Stay disabled until DB and auth are verified end to end.
CC_LIVE_ENABLED=false
# Leave BETTER_AUTH_URL unset in Preview; set fixed app origin only in production.
